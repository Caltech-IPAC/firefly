<config xmlns="http://www.ehcache.org/v3"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.ehcache.org/v3 http://www.ehcache.org/schema/ehcache-core-3.xsd">

    <!--
        ehcache 3 configuration reference — actual cache setup is done programmatically
        in EhcacheProvider.java, which reads AppProperties to determine heap sizes and TTI.

        VIS_SHARED_MEM:
          - Heap-only (no disk), memory-bounded
          - Default 100MB; overridden by vis.shared.mem.size or pct.vis.shared.mem.size
          - Time-to-idle: 3600s; overridden by vis.shared.tti.secs
          - LRU eviction (ehcache 3 default)

        PERM_SMALL:
          - Heap (1000 entries) + disk overflow (50000 entries), disk-persistent across restarts
          - No expiry by default; per-entry TTL supported via put(key, value, lifespanInSecs)
          - LRU eviction (ehcache 3 default)

        Disk store directory: ${java.io.tmpdir}/ehcache
    -->

</config>
